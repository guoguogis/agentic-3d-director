# 导演助手的 AI 接入配置（OpenAI 兼容接口）
# 用法：复制本文件为 .env，填入你自己的 key，然后重启 `npm run agent`。
# .env 已在 .gitignore 中，不会被提交。

# auto  ：有 AI_API_KEY 就直连 API，没有就回落到本机 codex CLI（默认）
# api   ：强制直连 API
# codex ：强制使用本机 codex CLI
AI_MODE=auto

# 接口地址，需包含版本前缀。常见取值：
#   OpenAI            https://api.openai.com/v1
#   DeepSeek          https://api.deepseek.com/v1
#   火山方舟 Ark       https://ark.cn-beijing.volces.com/api/v3
#   本地 Ollama       http://127.0.0.1:11434/v1
AI_BASE_URL=https://api.deepseek.com/v1

# 你的 API Key（只留在本机 .env，不会进入浏览器）
AI_API_KEY=

# 模型名（方舟请填 Endpoint ID 或模型名，如 doubao-seed-1-6-250615）
AI_MODEL=deepseek-chat

# 结构化输出降级策略：auto（json_schema → json_object → 纯文本）
# 有些兼容实现不支持 json_schema，可显式设为 json_object 或 none
AI_JSON_MODE=auto

# 可选：采样温度（0-2）、单次最大输出 token、请求超时（毫秒）
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=4096
# AI_TIMEOUT_MS=120000
